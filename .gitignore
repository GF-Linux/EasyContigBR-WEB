.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# Configuração real da máquina — o exemplo (.env.exemplo) é que é versionado.
.env

# ⚠️ FORA DO VERSIONAMENTO POR DECISÃO DE 08/09/2026: o núcleo científico (os
# .py da raiz) e o front (templates e estáticos). Eles são o mecanismo — a
# ciência e a tela —, e ficam só nas máquinas que precisam deles: aqui e a VPS.
# O repositório carrega o andaime (a web, a suíte, o empacotamento, a docs).
# ⚠️ Consequências, para ninguém descobrir na hora errada:
#   - um clone limpo NÃO sobe e NÃO passa na suíte; o conftest.py diz isso e diz
#     como resolver, em vez de estourar um ImportError cru;
#   - o `docker compose up --build` na VPS só funciona com os arquivos JÁ no
#     disco de lá: mande-os antes com `tools/enviar_privado.sh` (o Dockerfile
#     confere e FALHA no build se faltarem, em vez de subir uma imagem quebrada);
#   - não há mais cópia versionada destes arquivos em lugar nenhum. O que
#     protege é o backup desta máquina.
/*.py
/easycontig_web/templates/
/easycontig_web/estatico/

# ⚠️ NUNCA versionar: aqui ficam os .ab1 enviados pelos usuários. São dados de
# sequenciamento não publicados do laboratório. A barra na frente prende a
# regra à raiz: sem ela `dados/` também engolia o pacote easycontig_web/dados/
# (arquivo novo ali nunca entrava no git, e o original tinha a mesma armadilha).
/dados/
/bancos/

# Relatórios e logs do arnês de carga (tools/carga.sh) — o número interessa,
# o arquivo não: cada execução gera um novo, com selo de máquina e horário.
carga-*.json
carga-*.log
carga-execucao.txt
carga-vcpu.txt

# Candidatos das varreduras de seguranca. O padrao e GLOB, nao os nomes
# exatos: cada execucao cria uma pasta nova com carimbo novo, e listar as
# que ja existem deixa a PROXIMA de fora. O que ha ali dentro e a lista de
# vulnerabilidades ainda NAO corrigidas -- exatamente o que nao pode ser
# publicado por descuido.
CLAUDE-SECURITY-*/

# Documentos de auditoria e de checklist operacional: registram defeitos
# achados, o estado da instancia e o que ainda falta -- util para quem opera,
# e mapa para quem nao deveria. Copia em ../easycontig-docs-privados/
# ⚠️ ISTO NAO APAGA O QUE JA FOI PUBLICADO: seguem legiveis no historico
# (`git log -p`) ate alguem reescrever a arvore.
docs/auditoria-do-nucleo.md
docs/checklist-de-producao.md
docs/checklist.md
docs/achados-seguranca-*.md

# Testes de seguranca do proprio servidor — NUNCA publicar (repo publico)
Teste-Seguranca-GustavoFreitas/

# O exemplo antigo trazia caminhos pessoais da máquina do autor; o novo é o .env.exemplo
.env.example
