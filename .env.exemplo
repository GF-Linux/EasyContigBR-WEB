# Copie para .env e ajuste. Em desenvolvimento: `set -a; . ./.env; set +a`.
# Em produção o docker-compose.yml lê daqui só o que ele referencia (${...}).
# A tabela completa, com os padrões, está no README.md ("Configuração").

# --- onde as coisas estão -------------------------------------------------
EASYCONTIG_DATA_DIR=./dados
# prefixo BLAST sem extensão (o makeblastdb gera .nhr/.nin/.nsq ao lado); vazio = sem banco fixo
EASYCONTIG_DB_18S=./bancos/referencias_18S
EASYCONTIG_DB_16S=./bancos/referencias_16S
# só se não estiverem no PATH: executável (tracy, mb) ou pasta (blast, com blastn e makeblastdb)
EASYCONTIG_TRACY_BIN=
EASYCONTIG_BLAST_BIN=
EASYCONTIG_MRBAYES_BIN=

# --- a ciência --------------------------------------------------------------
EASYCONTIG_TRIM=4

# --- tetos ---------------------------------------------------------------------
EASYCONTIG_MAX_ARQUIVOS=400          # por lote
EASYCONTIG_MAX_BYTES=314572800       # por lote: 300 MiB
EASYCONTIG_MAX_LOTES_ATIVOS=10       # por conta: corridas em recebendo/na fila/rodando
EASYCONTIG_MAX_BYTES_CONTA=2147483648  # por conta: 2 GiB acumulados
EASYCONTIG_MAX_BANCOS_CONTA=12       # por conta: bancos próprios
EASYCONTIG_LIM_ENVIO=20              # envios de corrida por hora, por conta
EASYCONTIG_LIM_LEITURA=300           # leituras por minuto, por conta (IP se não entrou)
EASYCONTIG_LIM_BANCO=10              # montagens de banco por hora (protege o NCBI)
EASYCONTIG_LIM_LOGIN=20              # tentativas de entrada por 10 min, por IP
EASYCONTIG_LIM_PEDIDO=30             # pedidos de amostra por hora, por conta
EASYCONTIG_MAX_PESADAS=4             # remontagens/consultas BLAST ao mesmo tempo no web
EASYCONTIG_RETENCAO_DIAS=0           # 0 = nunca apagar; a produção usa 30

# --- quem entra ------------------------------------------------------------
EASYCONTIG_AUTH=dev                  # dev (qualquer e-mail, sem senha) ou google
EASYCONTIG_DOMINIO=                  # vazio = qualquer e-mail; em produção, o domínio do laboratório
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EASYCONTIG_ADMINS=                   # e-mails que podem remover banco compartilhado, separados por vírgula

# --- só em produção (a trava de arranque exige todos) -----------------------
EASYCONTIG_PRODUCAO=0
EASYCONTIG_SECRET_KEY=               # openssl rand -hex 32
EASYCONTIG_HTTPS_ONLY=0
EASYCONTIG_URL_BASE=                 # https://easycontigbr.com.br
EASYCONTIG_PROXIES_CONFIAVEIS=nenhum # de onde o proxy chega (no compose, o gateway 172.18.0.1); `nenhum` = não há proxy; vazio = X-Forwarded-For ignorado e a trava reclama
